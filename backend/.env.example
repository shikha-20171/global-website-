# ==============================================================================
# DEZORYN TECHNOLOGY — Enterprise Shared Backend Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL)
# Format for direct connection (Recommended for persistent servers & migrations):
# DATABASE_URL="postgresql://username:password@localhost:5432/dezoryn_db?schema=public"
# Format for Neon serverless pooler (if used):
# DATABASE_URL="postgresql://username:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/dezoryn?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://username:password@ep-xxxx.us-east-1.aws.neon.tech/dezoryn?sslmode=require"
DATABASE_URL="postgresql://username:password@localhost:5432/dezoryn_db?schema=public"

# Server Host & Port
PORT=5001
HOST="0.0.0.0"
NODE_ENV="development" # development | production | test

# Authentication & Cryptographic Secrets
# Minimum 32-character high-entropy secret string
JWT_SECRET="replace-with-a-secure-random-32-char-string-in-production"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (Frontend & Admin Origins)
FRONTEND_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Idempotent Super Administrator Bootstrap Credentials
BOOTSTRAP_ADMIN_EMAIL="admin@dezoryn.com"
BOOTSTRAP_ADMIN_PASSWORD="ReplaceWithAStrongPasswordMin10Chars!"
BOOTSTRAP_ADMIN_NAME="Super Administrator"

# Media Storage Provider
STORAGE_PROVIDER="local" # local | s3
# AWS_S3_BUCKET="dezoryn-media-assets"
# AWS_S3_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# ==============================================================================
# Nodemailer SMTP Configuration (Admin Forgot Password & Website Notifications)
# Works with Gmail (App Password), SendGrid, Amazon SES, Outlook, Brevo, or custom SMTP.
# Leave commented or empty to test locally (events and URLs will log to the console).
# ==============================================================================
# Option A: Gmail (Recommended for rapid testing with Google App Password)
# SMTP_SERVICE="gmail"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="abcd efgh ijkl mnop" # 16-character Google App Password (no spaces needed)

# Option B: Standard SMTP Server (SendGrid, Amazon SES, Brevo, Outlook, Hostinger, etc.)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false # Set to true if using SSL port 465, false for TLS port 587
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"

# Sender and Notification Preferences
# SMTP_FROM='"DEZORYN TECHNOLOGY" <no-reply@dezoryn.com>'
# ADMIN_NOTIFICATION_EMAIL="admin@dezoryn.com"

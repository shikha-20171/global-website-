{
  "name": "dezoryn-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise Backend and Database Service for DEZORYN TECHNOLOGY Global Website and Admin Panel",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:test": "tsx src/test-db.ts",
    "test:db": "tsx src/test-db.ts",
    "test:integration": "tsx src/test-integration.ts",
    "test": "tsx src/tests/comprehensive.test.ts",
    "test:comprehensive": "tsx src/tests/comprehensive.test.ts",
    "test:e2e": "tsx src/test-admin-website-e2e.ts",
    "test:apis": "tsx scripts/test-all-85-apis.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-super-admin.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "consolidate:roles": "tsx scripts/consolidate-super-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
